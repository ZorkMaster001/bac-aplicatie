# Șablon: copiază în .env și completează cu valorile proiectului tău.
#
#   cp .env.example .env
#
# Valorile se iau din Supabase → Project Settings → API Keys.
#
# Aici intră doar valori publice: tot ce începe cu EXPO_PUBLIC_ este inclus în
# bundle-ul aplicației și ajunge pe telefonul fiecărui utilizator. Cheia
# „publishable" e gândită exact pentru asta — datele sunt protejate de Row
# Level Security. Secretele (service_role, parola bazei de date) nu se pun
# nici aici, nici în .env, ci în .env.local.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
